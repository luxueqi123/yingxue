ality","count"],"generationMode":"image","prompt":"","composerContent":"","model":"","ltvReferencePlan":{"prompt":"","references":[{"nodeId":"41053409-f8d1-4991-bfba-1410734ad905","url":"https://libtv-res.liblib.art/upload-images/9c9ca63a3fd948e8abb9ab96ade97321/fcf680d8b8ef74bfa303929b25112c185332bff5.png","kind":"image"},{"nodeId":"e713092a-7bd6-4f67-aa9c-eef34f693e73","url":"https://libtv-res.liblib.art/upload-images/9c9ca63a3fd948e8abb9ab96ade97321/5e32496a6517d2cd1fbe463d6c50ab1775b823bc.jpg","kind":"image"}],"texts":[{"nodeId":"5a284fc6-7f8b-4013-975d-0e7d693e78e7","content":"**任务：**\\\n生成图1中开放式厨房与餐厅的真实摄影，空间布局严格遵守图2的平面设计图。画面不要出现人物。\\\n**画面细节：**\n\n现代北欧装修风格，明亮的白色为主色调。一个 L 形的现代白色厨房，配有浅色木质装饰和内置的不锈钢电器。\n\n厨房里有一个吧台，配有两把木质高脚凳。与吧台相连的部分是一张浅色橡木材质的餐桌，周围环绕着六把简约的浅灰色织物餐椅。餐厅区域的浅色橡木地板与厨房区域平滑过渡。温馨、舒适、适合家庭使\\\n**室内装修风格：**\\\n北欧风，原木材质，白色基调，自然采光，温馨舒适，注重实用与美观平衡。\\\n**画面要求：**\\\n照片级真实感的 CGI 渲染风格（V-Ray / Corona），全局光照，高端摄影风格，线条干净，无畸变，具有细微的环境景深效果。"}]}}},{"id":"ffe7ece0-1e26-4e96-868a-d8aef7ddc63b::saved::1","type":"image","title":"生成局部照片 · 版本 2","position":{"x":3435.159383582471,"y":-332.3174164208367},"width":469,"height":350,"parentId":"30a028a1-fdf5-4627-9181-f84ec00abea1","metadata":{"content":"https://libtv-res.liblib.art/sd-gen-save-img/genius_playground/image/9c9ca63a3fd948e8abb9ab96ade97321/0ee7a8ec25c8d2135de397ecf41a6585f39fca7db97bff4b8e01d75a4e2fcd8e.png","status":"success"}},{"id":"ffe7ece0-1e26-4e96-868a-d8aef7ddc63b::saved::2","type":"image","title":"生成局部照片 · 版本 3","position":{"x":3936.159383582471,"y":-332.3174164208367},"width":469,"height":350,"parentId":"30a028a1-fdf5-4627-9181-f84ec00abea1","metadata":{"content":"https://libtv-res.liblib.art/sd-gen-save-img/genius_playground/image/9c9ca63a3fd948e8abb9ab96ade97321/84f1fc5a0412e177b79a6a78f322c7448880b1053caf285f72ad4f0d2b2c0f8c.png","status":"success"}},{"id":"ffe7ece0-1e26-4e96-868a-d8aef7ddc63b::saved::3","type":"image","title":"生成局部照片 · 版本 4","position":{"x":4437.1593835824715,"y":-332.3174164208367},"width":469