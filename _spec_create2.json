   "                if (epoch !== draftEpochRef.current || activeIdRef.current !== activeConversation.id) throw new Error(\"当前草稿已变化，请确认后重新发送，新的输入已保留。\");",
   "                expandedPrompt = `${contents.join(\"\\n\\n\")}\\n\\n${expandedPrompt}`;",
