      "    try {",
      "        const stored = window.localStorage.getItem(key);",
      "        return stored === null ? fallback : stored === \"1\";",
      "    } catch {",
      "        return fallback;",
      "    }",
      "}",
      "function writeComposerPref(key: string, value: boolean) {",
      "    try {",
      "        window.localStorage.setItem(key, value ? \"1\" : \"0\");",
      "    } catch {",
