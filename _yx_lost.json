  17,
  44,
  [
   "import { cn } from \"@/lib/utils\";",
   "    // 项目详情等工作台页面通过 WorkspaceTopBarExtensionProvider 注册自己的顶栏内容；",
   "    // 注册成功后顶栏主体让位给扩展内容，当前位置面包屑收进 2xl 断点保留。",
   "    const extension = useWorkspaceTopBarContent();",
   "        <header className={cn(\"app-workspace-topbar flex shrink-0 items-center justify-between gap-3 px-3 sm:px-4\", extension && \"has-extension\")}>",
   "            <div className=\"flex min-w-0 flex-1 items-center gap-1.5\">",
   "                <button type=\"button\" className=\"app-workspace-topbar-icon-button\" aria-label={sidebarOpen ? \"收起侧栏\" : \"展开侧栏\"} onClick={onToggleSidebar}>",
   "                    {sidebarOpen ? <PanelLeftClose className=\"size-4\" /> : <PanelLeftOpen className=\"size-4\" />}",
   "                </button>",
   "                <nav className={cn(\"min-w-0 items-center gap-2 text-[var(--fs-caption)] text-foreground/50\", extension ? \"hidden 2xl:flex\" : \"flex\")} aria-label=\"当前位置\">",
   "                    <Link to=\"/\" aria-label=\"映雪首页\" className=\"shrink-0 font-medium text-foreground/70 transition-colors hover:text-foreground\"><YingxueBrandLettering className=\"h-5 w-12\" /></Link>",
   "                    <span className=\"shrink-0 text-foreground/30\">/</span>",
   "                    <span className=\"truncate font-medium text-foreground\">{pageTitle}</span>",
   "                </nav>",
   "                {extension ? <div className=\"flex min-w-0 flex-1 items-center gap-2\">{extension}</div> : null}",
   "            <div className=\"flex shrink-0 items-center gap-1\">",
   "                {user ? <SystemAnnouncementCenter userId={user.id} className=\"app-workspace-topbar-icon-button\" /> : null}"
  ]
 ],
